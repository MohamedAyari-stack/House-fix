APP_NAME=DarFix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Application Angular : cible des liens envoyés par email (mot de passe oublié, notifications).
FRONTEND_URL=http://localhost:4200

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de données : SQLite par défaut (database/database.sqlite).
DB_CONNECTION=sqlite

# MySQL (XAMPP) : commenter DB_CONNECTION=sqlite ci-dessus et décommenter ces lignes.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=housefix
# DB_USERNAME=root
# DB_PASSWORD=

# Origines autorisées (CORS) pour /api/*, séparées par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:4200

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Emails : envoyés par l’API Brevo (gratuit, 300 emails/jour, https://www.brevo.com).
# 1. Créer un compte Brevo avec l’adresse d’expédition (elle devient un expéditeur vérifié).
# 2. Brevo > SMTP & API > onglet "Clés API" > Générer une clé, puis la coller dans BREVO_API_KEY.
# Pour tester sans Brevo : MAIL_MAILER=smtp avec Mailpit (MAIL_HOST=127.0.0.1, MAIL_PORT=1025),
# emails lisibles sur http://localhost:8025.
MAIL_MAILER=log
BREVO_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@housefix.tn"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Service de recommandation IA (ai-recommendation-service/). Arrêté : formule locale.
AI_RECO_URL=http://127.0.0.1:8100
AI_RECO_KEY=
